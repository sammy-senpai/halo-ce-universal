<?xml version="1.0" encoding="utf-8"?>
<!-- The fire button: the same glass, tinted with the HUD's blue. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#994FC3F7" />
            <stroke android:width="2.5dp" android:color="#FFB3E5FC" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#3329B6F6" />
            <stroke android:width="2.5dp" android:color="#E64FC3F7" />
        </shape>
    </item>
</selector>
